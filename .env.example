# ─── Supabase ─────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Google OAuth (configured inside Supabase dashboard) ──────────────────────
# No client-side env needed — configured in Supabase Auth → Providers → Google
# GOOGLE_CLIENT_ID=...   (set in Supabase dashboard, not here)
# GOOGLE_CLIENT_SECRET=... (set in Supabase dashboard, not here)

# ─── Redirect URLs ────────────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:5173
VITE_AUTH_REDIRECT_URL=http://localhost:5173/auth/callback

# ─── Optional: Razorpay (payment gateway) ─────────────────────────────────────
# VITE_RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...   (Edge Function secret — set via `supabase secrets set`)

# ─── Optional: Firebase Cloud Messaging (push notifications) ─────────────────
# VITE_FCM_VAPID_KEY=...
# FCM_SERVER_KEY=...        (Edge Function secret — set via `supabase secrets set`)
